{
    "name": "daawafy/pharmacy-management-system",
    "type": "project",
    "description": "Daawafy Professional Pharmacy Management System - Laravel Architecture with React JS & jQuery Pop-ups.",
    "keywords": ["laravel", "pharmacy", "pos", "react", "jquery", "tmda"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
